# Salin file ini menjadi .env.test lalu isi nilainya. File .env.test tidak masuk git.
# Dipakai oleh vitest (vitest.config.ts) saat menjalankan npm run test:integration.

NODE_ENV=test

# WAJIB database terpisah dari database dev. Setup test menjalankan
# `prisma migrate reset --force` dan TRUNCATE semua tabel sebelum tiap test.
DATABASE_URL="postgresql://postgres:password@localhost:5432/event_db_test"

# Cloudinary. Isi nilai akun test, atau dummy jika test tidak menyentuh upload.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# String acak minimal 32 karakter. Buat dengan:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""
JWT_SECRET_RESET=""

# Port server Express.
PORT=8000
