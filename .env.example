# Salin file ini menjadi .env lalu isi nilainya sesuai komputer masing-masing.

# Koneksi PostgreSQL lokal. Ganti user, password, dan nama database.
DATABASE_URL="postgresql://user:password@localhost:5432/event_db"

# String acak minimal 32 karakter. Buat dengan:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# Port server Express.
PORT=8000
