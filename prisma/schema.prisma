// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ORGANIZER
}

enum PaymentStatus {
  WAITING_FOR_PAYMENT
  WAITING_FOR_CONFIRMATION
  PAID
  REJECTED
  EXPIRED
  CANCELED
}

enum EventType {
  VENUE
  ONLINE
}

enum ReviewType {
  EVENT
  ORGANIZER
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  password     String
  role         Role     @default(CUSTOMER)
  picture      String?
  referralCode String   @unique @map("referral_code")
  referredById Int?     @map("referred_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  referredBy   User?         @relation("Referral", fields: [referredById], references: [id])
  referrals    User[]        @relation("Referral")
  organization Organization?

  orders  Order[]
  points  Point[]
  coupons Coupon[]

  @@map("users")
}

model Point {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  orderId   Int?     @map("order_id")
  amount    Int
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user  User   @relation(fields: [userId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])

  @@map("points")
}

model Coupon {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  code          String   @unique
  discountValue Int      @map("discount_value")
  isUsed        Boolean  @default(false) @map("is_used")
  createdAt     DateTime @default(now()) @map("created_at")
  expiresAt     DateTime @map("expires_at")

  user   User    @relation(fields: [userId], references: [id])
  orders Order[]

  @@map("coupons")
}

model Order {
  id              Int           @id @default(autoincrement())
  userId          Int           @map("user_id")
  ticketId        Int           @map("ticket_id")
  pointsUsed      Int           @default(0) @map("points_used")
  couponId        Int?          @map("coupon_id")
  paymentStatus   PaymentStatus @default(WAITING_FOR_PAYMENT) @map("payment_status")
  paymentProofUrl String?       @map("payment_proof_url")
  quantity        Int
  total           Int
  paidAt          DateTime?     @map("paid_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  expiresAt       DateTime?     @map("expires_at")
  voucherId       Int?          @map("voucher_id")
  discount        Int           @default(0)
  finalPrice      Int           @map("final_price")

  user    User     @relation(fields: [userId], references: [id])
  ticket  Ticket   @relation(fields: [ticketId], references: [id])
  coupon  Coupon?  @relation(fields: [couponId], references: [id])
  points  Point[]
  reviews Review[]
  voucher Voucher? @relation(fields: [voucherId], references: [id])

  @@map("orders")
}

model Organization {
  id          Int     @id @default(autoincrement())
  userId      Int     @unique @map("user_id")
  name        String
  logo        String?
  description String?
  field       String?

  user   User    @relation(fields: [userId], references: [id])
  events Event[]

  @@map("organizations")
}

model Category {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?

  events Event[]

  @@map("categories")
}

model Event {
  id             Int       @id @default(autoincrement())
  categoryId     Int       @map("category_id")
  organizationId Int       @map("organization_id")
  name           String
  description    String?
  city           String
  type           EventType @default(VENUE)
  slug           String    @unique
  image          String?
  startDate      DateTime  @map("start_date")
  endDate        DateTime  @map("end_date")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  category     Category     @relation(fields: [categoryId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  tickets      Ticket[]
  vouchers     Voucher[]

  @@map("events")
}

model Ticket {
  id                Int    @id @default(autoincrement())
  eventId           Int    @map("event_id")
  name              String
  price             Int
  quantity          Int
  availableQuantity Int    @map("available_quantity")

  event  Event   @relation(fields: [eventId], references: [id])
  orders Order[]

  @@map("tickets")
}

model Review {
  id        Int        @id @default(autoincrement())
  rating    Int
  title     String
  comment   String
  type      ReviewType
  orderId   Int        @map("order_id")
  createdAt DateTime   @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id])

  @@unique([orderId, type])
  @@map("reviews")
}

model Voucher {
  id            Int      @id @default(autoincrement())
  eventId       Int      @map("event_id")
  code          String   @unique
  discountValue Int      @map("discount_value")
  quota         Int
  startDate     DateTime @map("start_date")
  endDate       DateTime @map("end_date")
  createdAt     DateTime @default(now()) @map("created_at")

  event  Event   @relation(fields: [eventId], references: [id])
  orders Order[]

  @@map("vouchers")
}
